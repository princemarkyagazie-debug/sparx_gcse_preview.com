<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>GCSE Biology Preview</title>
<style>
:root{--bg:#000;--panel:#111;--panel2:#181818;--line:#303030;--text:#f5f5f5;--muted:#aaa;--blue:#8ab4f8;--green:#81c995;--red:#f28b82;--yellow:#fdd663}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font:14px/1.5 Arial,system-ui,sans-serif}button,input,textarea{font:inherit}button{cursor:pointer}.topbar{height:58px;padding:16px 28px;display:flex;justify-content:flex-end;gap:20px;color:var(--muted);font-size:13px}.topbar a{color:inherit;text-decoration:none}.topbar a:hover{text-decoration:underline}main{max-width:1080px;margin:auto;padding:20px 20px 55px}.logo{display:flex;justify-content:center;margin:15px 0 22px;font-size:clamp(48px,8vw,78px);font-weight:700;letter-spacing:-7px;line-height:1}.logo span{display:inline-block}.blue{color:var(--blue)}.red{color:var(--red)}.yellow{color:var(--yellow)}.green{color:var(--green)}.search{max-width:760px;margin:auto;display:flex;align-items:center;gap:12px;padding:9px 12px 9px 20px;background:#111;border:1px solid #454545;border-radius:32px;box-shadow:0 1px 8px #000}.search:focus-within{border-color:var(--blue);box-shadow:0 1px 10px #8ab4f844}.search svg{width:20px;height:20px;color:#aaa;flex:none}.search input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--text);font-size:16px;padding:7px 0}.btn{border:1px solid transparent;border-radius:22px;padding:10px 17px;font-weight:600}.primary{background:var(--blue);color:#07111f}.soft{background:#1b1b1b;color:var(--text);border-color:#3b3b3b}.soft:hover{background:#292929}.actions,.options,.status{display:flex;flex-wrap:wrap;align-items:center;gap:10px;justify-content:center}.actions{margin:16px 0 9px}.options{justify-content:flex-start;max-width:760px;margin:0 auto 16px;padding-left:5px;color:var(--muted);font-size:13px}.options label{display:flex;align-items:center;gap:6px}.status{justify-content:flex-start;max-width:760px;margin:0 auto 18px}.status span{padding:9px 13px;background:var(--panel);border:1px solid var(--line);border-radius:10px;color:var(--muted)}.status .error{color:var(--red);border-color:#633}.grid{display:grid;grid-template-columns:1.7fr 1fr;gap:18px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:20px;box-shadow:0 8px 26px #0008}.panel h2{font-size:16px;margin:0 0 12px}.meta{color:var(--muted);font-size:13px}.results{display:grid;gap:11px;margin-top:13px}.result{border:1px solid var(--line);border-radius:13px;padding:13px 15px;background:var(--panel2)}.result .url{font-size:12px;color:var(--green);margin-bottom:4px}.result h3{font-size:17px;color:var(--blue);margin:0 0 4px}.result p{margin:0;color:var(--muted);overflow-wrap:anywhere}.empty{color:var(--muted);padding:10px 0}.source{margin-top:18px}.source label{display:block;color:var(--muted);margin-bottom:8px}.urlrow{display:flex;gap:9px;margin-bottom:13px}.urlrow input,.source textarea{width:100%;min-width:0;border:1px solid var(--line);border-radius:11px;padding:11px 13px;outline:0;background:#0c0c0c;color:var(--text)}.source textarea{min-height:180px;resize:vertical}.urlrow input:focus,.source textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px #8ab4f822}.correction{max-width:760px;margin:18px auto;padding:10px 14px;background:#171717;border:1px solid var(--line);border-radius:12px;color:var(--muted)}.correction button{margin-left:8px;padding:5px 10px;border-radius:14px;background:#222;color:var(--text);border:1px solid #444}@media(max-width:760px){.grid{grid-template-columns:1fr}.topbar{padding-right:16px}.search .primary{display:none}main{padding:18px 13px 40px}.urlrow{flex-direction:column}}
</style>
</head>
<body>
<header class="topbar"><a href="#">About</a><a href="#">Search tools</a><a href="#">Help</a></header>
<main>
<div class="logo" aria-label="GCSE"><span class="blue">G</span><span class="red">C</span><span class="yellow">S</span><span class="green">E</span></div>
<div class="search" role="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6"/><path d="m16 16 5 5"/></svg><input id="searchBox" spellcheck="true" placeholder="Search loaded source or the web" autocomplete="off"><button id="find" class="btn primary">Search</button></div>
<div id="correction" class="correction" hidden></div>
<div class="actions"><button id="load" class="btn soft">Load latest GUST</button><button id="webSearch" class="btn soft">Search web</button><button id="paste" class="btn soft">Paste HTML</button></div>
<div class="options"><label><input id="regex" type="checkbox"> regex</label><label><input id="caseSensitive" type="checkbox"> case sensitive</label><label><input id="autoCorrect" type="checkbox" checked> correct spelling</label><button id="clearSearch" class="btn soft">Clear</button></div>
<div class="status"><span id="status">No source loaded.</span></div>
<div class="grid"><section class="panel"><h2>Search results</h2><div id="searchMeta" class="meta">No search yet.</div><div id="searchResults" class="results"><div class="empty">Load or paste HTML, then search.</div></div></section><section class="panel source"><label for="domain">Load a domain or HTML URL</label><div class="urlrow"><input id="domain" placeholder="example.com or https://example.com/index.html" autocomplete="url"><button id="loadDomain" class="btn primary">Load</button></div><textarea id="source" placeholder="Paste HTML here if fetch is blocked by the browser or network."></textarea></section></div>
</main>
<script>
(()=>{'use strict';
const rawUrl='https://raw.githubusercontent.com/nautilus-os/GUST/main/index.html';
const q=s=>document.querySelector(s), searchBox=q('#searchBox'), sourceBox=q('#source'), results=q('#searchResults'), meta=q('#searchMeta'), statusBox=q('#status'), correction=q('#correction');
let source='';
const dictionary={teh:'the',recieve:'receive',seperate:'separate',definately:'definitely',occured:'occurred',alot:'a lot',becuase:'because',adress:'address',acheive:'achieve',wierd:'weird',untill:'until',begining:'beginning',enviroment:'environment',scince:'science',biolgy:'biology',photosytethesis:'photosynthesis',respirationn:'respiration'};
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const escRe=s=>String(s).replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
function setStatus(text,error=false){statusBox.textContent=text;statusBox.classList.toggle('error',error)}
function correct(text){return text.replace(/\b[A-Za-z']+\b/g,w=>dictionary[w.toLowerCase()]||w)}
function offerCorrection(){if(!q('#autoCorrect').checked){correction.hidden=true;return}const value=searchBox.value,fixed=correct(value);if(value&&fixed!==value){correction.hidden=false;correction.innerHTML=`Did you mean <strong>${esc(fixed)}</strong>? <button id="useCorrection">Use correction</button>`;q('#useCorrection').onclick=()=>{searchBox.value=fixed;correction.hidden=true;search()}}else correction.hidden=true}
function search(){offerCorrection();const term=searchBox.value.trim(),hay=source||sourceBox.value||'';if(!term){meta.textContent='No search yet.';results.innerHTML='<div class="empty">Enter a search term to search inside this website.</div>';return}if(!hay){meta.textContent='No source loaded.';results.innerHTML='<div class="empty">Load or paste HTML first, then search.</div>';return}const rx=q('#regex').checked,cs=q('#caseSensitive').checked;let re;try{re=new RegExp(rx?term:escRe(term),cs?'g':'gi')}catch(e){meta.textContent='Search error';results.innerHTML=`<div class="empty">${esc(e.message)}</div>`;return}const hits=[];let m;while((m=re.exec(hay))&&hits.length<10){hits.push(m);if(!m[0])re.lastIndex++}meta.textContent=`${hits.length} result${hits.length===1?'':'s'} found in the loaded source`;results.innerHTML=hits.length?hits.map((m,i)=>{const start=Math.max(0,m.index-120),before=hay.slice(start,m.index),after=hay.slice(m.index+m[0].length,m.index+m[0].length+220);return `<article class="result"><div class="url">Result ${i+1}</div><h3>Match ${i+1}</h3><p>${esc(before)}<mark>${esc(m[0])}</mark>${esc(after)}</p></article>`}).join(''):'<div class="empty">No matches found.</div>'}
function setSource(text){source=text||'';sourceBox.value=source;setStatus(source?`Loaded ${source.length.toLocaleString()} characters. Search locally or open a web search.`:'No source loaded.');search()}
async function fetchHtml(url,label){setStatus(`Loading ${label||url}…`);try{const res=await fetch(url,{cache:'no-store'});if(!res.ok)throw Error(`${res.status} ${res.statusText}`);setSource(await res.text());setStatus(`Loaded source from ${url}.`)}catch(e){setStatus(`Could not load: ${e.message}. Paste the HTML instead.`,true)}}
function normalise(value){value=value.trim();if(!value)return '';if(!/^https?:\/\//i.test(value))value='https://'+value;const url=new URL(value);if(!/^https?:$/.test(url.protocol))throw Error('Only HTTP and HTTPS URLs are supported.');return url.href}
q('#find').onclick=search;
// Enter deliberately performs the website's local search instead of submitting or navigating to Google.
searchBox.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();search()}});
q('#load').onclick=()=>fetchHtml(rawUrl,'latest GUST source');
q('#webSearch').onclick=()=>{const term=searchBox.value.trim();if(!term)return setStatus('Enter a search term first.',true);window.open('https://www.google.com/search?q='+encodeURIComponent(term),'_blank','noopener,noreferrer')};
q('#paste').onclick=()=>{const value=prompt('Paste HTML here:');if(value!==null)setSource(value)};
q('#loadDomain').onclick=()=>{try{const url=normalise(q('#domain').value);if(!url)return setStatus('Enter a domain or URL first.',true);fetchHtml(url,url)}catch(e){setStatus(e.message,true)}};
q('#source').oninput=()=>setSource(sourceBox.value);q('#regex').onchange=search;q('#caseSensitive').onchange=search;q('#clearSearch').onclick=()=>{searchBox.value='';correction.hidden=true;search()};
setStatus('Ready. Search locally inside the website.');
})();
</script>
</body>
</html>
