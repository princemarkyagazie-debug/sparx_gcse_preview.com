<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>GUST Patcher</title>
<style>
:host{all:initial}*{box-sizing:border-box}body{margin:0;background:#101318;color:#eef3f8;font:14px system-ui,sans-serif}main{max-width:900px;margin:auto;padding:24px}h1{margin:0 0 6px;color:#9de5ff}p{color:#aab5c0}.bar,.card{background:#1b2129;border:1px solid #485361;border-radius:10px;padding:16px;margin:14px 0}.bar{display:flex;gap:10px;flex-wrap:wrap;align-items:center}button,input,textarea{font:inherit}button{border:0;border-radius:7px;padding:9px 13px;background:#9de5ff;color:#071016;font-weight:700;cursor:pointer}button.alt{background:#252d36;color:#eef3f8;border:1px solid #586575}button:disabled{opacity:.45;cursor:not-allowed}input[type=file]{max-width:220px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.item{display:flex;gap:10px;align-items:flex-start;background:#252d36;border:1px solid #465260;border-radius:8px;padding:11px}.item input{margin-top:3px;accent-color:#9de5ff}.item small{display:block;color:#9aa7b4;margin-top:3px}.status{font-family:ui-monospace,monospace;color:#9de5ff;white-space:pre-wrap}.error{color:#ff9b9b}textarea{width:100%;min-height:180px;resize:vertical;background:#0d1014;color:#eef3f8;border:1px solid #485361;border-radius:7px;padding:10px}
</style>
<main id="gust-patcher">
<h1>GUST Patcher</h1><p>Load GUST, choose safe removals, then download the patched file.</p>
<div class="bar"><button id="load">Fetch latest GUST</button><button class="alt" id="paste">Paste source</button><input id="file" type="file" accept=".html,.htm,text/html"><button id="download" disabled>Download</button></div>
<div class="card"><strong>Patches</strong><div class="grid" id="patches"></div></div>
<div class="card"><strong>Manual source</strong><textarea id="source" placeholder="Paste GUST index.html here if fetching is blocked by the host/browser…"></textarea></div>
<div class="card status" id="status">No source loaded.</div>
</main>
<script>
(()=>{
'use strict';
const root=document.getElementById('gust-patcher'),$=s=>root.querySelector(s),raw='https://raw.githubusercontent.com/nautilus-os/GUST/main/index.html';
let source='',out='';
/* Each rule is deliberately conservative: only its own marker is removed. Add rules here
   when GUST changes instead of maintaining a large string of inline handlers. */
const rules=[
 ['wisp-url','WISP URL input','Removes the WISP server URL setting',/<!--[\s\S]*?WISP[\s\S]*?-->|(?:<label[^>]*>[^<]*(?:WISP|WebSocket)[^<]*<\/label>[\s\S]*?<input[^>]*(?:url|wisp)[^>]*>)/gi],
 ['threads','Thread controls','Removes idle/active thread controls',/<!--[\s\S]*?thread[\s\S]*?-->|(?:<[^>]+>[^<]*thread[^<]*<\/[^>]+>)/gi],
 ['webrtc','WebRTC blocking','Removes WebRTC blocking setting',/<!--[\s\S]*?WebRTC[\s\S]*?-->|(?:<[^>]+>[^<]*WebRTC[^<]*<\/[^>]+>)/gi],
 ['media-headers','Smart request headers','Removes request-header spoofing setting',/<!--[\s\S]*?(?:Sec-Fetch|Referer)[\s\S]*?-->|(?:<[^>]+>[^<]*(?:Sec-Fetch|Referer)[^<]*<\/[^>]+>)/gi],
 ['spellcheck','Spellcheck','Removes spellcheck setting',/<!--[\s\S]*?spellcheck[\s\S]*?-->|(?:<[^>]+>[^<]*spellcheck[^<]*<\/[^>]+>)/gi],
 ['search-favicon','Favicon proxy','Removes favicon proxy setting',/<!--[\s\S]*?favicon[\s\S]*?-->|(?:<[^>]+>[^<]*favicon[^<]*<\/[^>]+>)/gi],
 ['ua-request','Request user-agent','Removes request UA setting',/<!--[\s\S]*?user.?agent[\s\S]*?-->|(?:<[^>]+>[^<]*user.?agent[^<]*<\/[^>]+>)/gi],
 ['custom-filters','Custom filters','Removes custom filter setting',/<!--[\s\S]*?custom filter[\s\S]*?-->|(?:<[^>]+>[^<]*custom filter[^<]*<\/[^>]+>)/gi],
 ['tutorial','Tutorial','Removes tutorial markup',/<!--[\s\S]*?tutorial[\s\S]*?-->|(?:<[^>]+>[^<]*tutorial[^<]*<\/[^>]+>)/gi]
];
const patchBox=$('#patches');rules.forEach(([id,name,desc])=>patchBox.insertAdjacentHTML('beforeend',`<label class="item"><input type="checkbox" data-rule="${id}"><span><b>${name}</b><small>${desc}</small></span></label>`));
const setStatus=(s,error=false)=>{$('#status').textContent=s;$('#status').className='card status'+(error?' error':'')};
const setSource=s=>{source=String(s||'');$('#source').value=source;out='';$('#download').disabled=!source;setStatus(source?`Loaded ${source.length.toLocaleString()} characters. Select patches and download.`:'No source loaded.');};
async function load(){setStatus('Fetching GUST…');try{let r=await fetch(raw,{cache:'no-store'});if(!r.ok)throw Error(`${r.status} ${r.statusText}`);setSource(await r.text())}catch(e){setStatus('Fetch failed. Paste the source or choose the HTML file instead.\n'+e.message,true)}}
$('#load').onclick=load;$('#paste').onclick=()=>{const v=prompt('Paste GUST index.html:');if(v)setSource(v)};$('#file').onchange=async e=>{const f=e.target.files[0];if(f)setSource(await f.text())};$('#source').oninput=e=>{source=e.target.value;out='';$('#download').disabled=!source;};
$('#download').onclick=()=>{if(!source)return;out=source;let removed=0;rules.forEach(([id,, ,rx])=>{if($(`[data-rule="${id}"]`).checked)out=out.replace(rx,()=>{removed++;return ''})});if(!removed){setStatus('No selected rule matched the loaded source.',true);return}let blob=new Blob([out],{type:'text/html'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='gust-patched.html';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);setStatus(`Downloaded gust-patched.html\nRemoved ${removed} matching block(s).`)};
load();
})();
</script>
</html>
